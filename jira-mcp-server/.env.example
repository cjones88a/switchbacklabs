# Jira Cloud site URL (no trailing slash)
JIRA_URL=https://yourcompany.atlassian.net

# Atlassian account email tied to the API token
JIRA_EMAIL=you@company.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token

# Optional: Story Points custom field ID (e.g. customfield_10016). If unset, the
# server tries to auto-detect a field whose name contains "story points".
# JIRA_STORY_POINTS_FIELD_ID=customfield_10016

# HTTP transport (when running: jira-mcp-server --transport http)
# JIRA_MCP_HTTP_HOST=127.0.0.1
# JIRA_MCP_HTTP_PORT=8765
